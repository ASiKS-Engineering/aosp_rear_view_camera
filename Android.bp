android_app {
    name: "OpenRearViewCamera",
    srcs: ["app/src/main/java/**/*.kt"],
    resource_dirs: ["app/src/main/res"],
    manifest: "app/src/main/AndroidManifest.xml",
    platform_apis: true,
    privileged: true,
    certificate: "platform",
    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx.core_core-ktx",
        "com.google.android.material_material",
        "androidx.camera_camera-camera2",
        "androidx.camera_camera-lifecycle",
        "androidx.camera_camera-view_local",
    ],
    libs: ["android.car"],
    optimize: {
        enabled: false,
    },
}

// androidx.camera:camera-view is not part of the prebuilts/sdk androidx snapshot, so import it locally.
android_library_import {
    name: "androidx.camera_camera-view_local",
    aars: ["libs/androidx.camera_camera-view.aar"],
    static_libs: [
        "androidx.camera_camera-core",
        "androidx.appcompat_appcompat",
    ],
    sdk_version: "current",
}

prebuilt_etc {
    name: "privapp-permissions-com.example.openrearviewcamera.xml",
    sub_dir: "permissions",
    src: "privapp-permissions-com.example.openrearviewcamera.xml",
    filename_from_src: true,
}
